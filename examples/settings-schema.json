{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "developerInstructions": { "type": "string" },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,47}$"}},
        "servers": {
          "type":"object","maxProperties":64,"propertyNames":{"pattern":"^[a-z][a-z0-9_-]{0,47}$"},
          "additionalProperties":{"type":"object","additionalProperties":false,"required":["url"],"properties":{"url":{"type":"string","maxLength":2048}}}
        }
      }
    }
  }
}
