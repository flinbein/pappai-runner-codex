{
  "run": {
    "type": "codex",
    "settings": {
      "developerInstructions": "Complete the task in data.input. Reply in the user's language.",
      "features": {
        "agent.execute": {
          "type": "method",
          "description": "Complete a text assignment",
          "version": "1",
          "schema": {
            "input": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "input"
              ],
              "additionalProperties": false
            },
            "output": {
              "type": "string"
            }
          }
        },
        "agent.getHistory": {
          "type": "method",
          "version": "1",
          "description": "Return a page of conversation history",
          "schema": {
            "input": {
              "type": "object",
              "properties": {
                "cursor": {
                  "type": "string"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              },
              "additionalProperties": false
            }
          }
        },
        "agent.interrupt": {
          "type": "method",
          "version": "1",
          "description": "Interrupt the active turn",
          "schema": {
            "input": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      }
    }
  },
  "executors": {
    "mode": "persistent",
    "idleTimeoutMs": 300000
  }
}
